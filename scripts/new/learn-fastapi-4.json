{
 "id": "request-body",
 "icon": "📦",
 "title": {
  "en": "Request Bodies & Responses",
  "ar": "جسم الطلب والاستجابات"
 },
 "summary": {
  "en": "Receive JSON with Pydantic models, validate it, and control what your API sends back.",
  "ar": "استقبل JSON باستخدام نماذج Pydantic، وتحقّق منه، وتحكّم فيما ترسله واجهتك (API)."
 },
 "lessons": [
  {
   "id": "why-request-body",
   "title": {
    "en": "Request bodies and Pydantic models",
    "ar": "جسم الطلب ونماذج Pydantic"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "📦",
     "en": "Big data rides in the request body",
     "ar": "البيانات الكبيرة تُرسل في جسم الطلب (request body)"
    },
    {
     "type": "flow",
     "nodes": [
      {
       "icon": "💻",
       "label": {
        "en": "Client sends JSON",
        "ar": "العميل يرسل JSON"
       }
      },
      {
       "icon": "🧩",
       "label": {
        "en": "Pydantic model checks",
        "ar": "نموذج Pydantic يتحقق"
       }
      },
      {
       "icon": "🐍",
       "label": {
        "en": "Your function runs",
        "ar": "دالتك تعمل"
       }
      }
     ],
     "links": [
      {
       "label": {
        "en": "JSON body",
        "ar": "جسم JSON"
       }
      },
      {
       "label": {
        "en": "ready Item object",
        "ar": "كائن Item جاهز"
       }
      }
     ]
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "POST",
       "color": "blue",
       "label": {
        "en": "method",
        "ar": "الطريقة (method)"
       }
      },
      {
       "text": " /items",
       "color": "green",
       "label": {
        "en": "path",
        "ar": "المسار (path)"
       }
      },
      {
       "text": "\nContent-Type: application/json",
       "color": "purple",
       "label": {
        "en": "says: body is JSON",
        "ar": "يقول: الجسم بصيغة JSON"
       }
      },
      {
       "text": "\n\n"
      },
      {
       "text": "{\"name\": \"Pen\", \"price\": 2.5}",
       "color": "yellow",
       "label": {
        "en": "request body",
        "ar": "جسم الطلب"
       }
      }
     ]
    },
    {
     "type": "pills",
     "items": [
      {
       "text": "POST",
       "color": "green",
       "label": {
        "en": "create, has body",
        "ar": "إنشاء، له جسم"
       }
      },
      {
       "text": "PUT",
       "color": "blue",
       "label": {
        "en": "update, has body",
        "ar": "تحديث، له جسم"
       }
      },
      {
       "text": "GET",
       "color": "yellow",
       "label": {
        "en": "usually no body",
        "ar": "عادةً بلا جسم"
       }
      }
     ]
    },
    {
     "type": "code",
     "lang": "python",
     "code": "from pydantic import BaseModel\n\n\nclass Item(BaseModel):\n    name: str                        # required\n    price: float                     # required\n    description: str | None = None   # optional\n    in_stock: bool = True            # has a default",
     "highlight": [
      4,
      5,
      7,
      8
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "❗",
       "color": "red",
       "title": {
        "en": "No default",
        "ar": "بلا قيمة افتراضية"
       },
       "text": {
        "en": "`name: str` is required",
        "ar": "`name: str` حقل إلزامي"
       }
      },
      {
       "icon": "✅",
       "color": "green",
       "title": {
        "en": "Has a default",
        "ar": "له قيمة افتراضية"
       },
       "text": {
        "en": "`in_stock: bool = True` can be left out",
        "ar": "`in_stock: bool = True` يمكن حذفه"
       }
      },
      {
       "icon": "❔",
       "color": "blue",
       "title": {
        "en": "Optional",
        "ar": "اختياري"
       },
       "text": {
        "en": "`str | None = None`: missing or `null` is fine",
        "ar": "`str | None = None`: غيابه أو `null` مقبول"
       }
      }
     ]
    },
    {
     "type": "tip",
     "en": "Run `fastapi dev main.py`, open `/docs`: each model shows a \"Request body\" example.",
     "ar": "شغّل `fastapi dev main.py` وافتح `/docs`: كل نموذج يعرض مثال \"Request body\"."
    }
   ]
  },
  {
   "id": "receiving-the-body",
   "title": {
    "en": "Receiving the body and its errors",
    "ar": "استقبال الجسم وأخطاؤه"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🛂",
     "en": "FastAPI checks the body before your code",
     "ar": "FastAPI يتحقق من الجسم قبل تشغيل كودك"
    },
    {
     "type": "code",
     "lang": "python",
     "code": "@app.post(\"/items\")\ndef create_item(item: Item):\n    total = item.price * 2           # attributes, not item[\"price\"]\n    data = item.model_dump()         # convert to a plain dict\n    return {\"name\": item.name, \"double_price\": total, \"data\": data}",
     "highlight": [
      2,
      3,
      4
     ]
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "POST /items  {\"name\": \"Pen\", \"price\": 2.5}",
       "note": {
        "en": "a valid body",
        "ar": "جسم صالح"
       }
      },
      {
       "from": "server",
       "text": "200 OK  {\"name\": \"Pen\", \"double_price\": 5.0, ...}",
       "note": {
        "en": "your function ran",
        "ar": "دالتك اشتغلت"
       }
      },
      {
       "from": "client",
       "text": "POST /items  {\"name\": \"Pen\"}",
       "note": {
        "en": "price is missing",
        "ar": "السعر غير موجود"
       }
      },
      {
       "from": "server",
       "text": "422  \"type\": \"missing\", \"loc\": [\"body\", \"price\"]",
       "note": {
        "en": "function never ran",
        "ar": "الدالة لم تعمل أبدًا"
       }
      },
      {
       "from": "client",
       "text": "POST /items  {\"name\": \"Pen\", \"price\": \"cheap\"}",
       "note": {
        "en": "price is not a number",
        "ar": "السعر ليس رقمًا"
       }
      },
      {
       "from": "server",
       "text": "422  \"type\": \"float_parsing\"",
       "note": {
        "en": "rejected again",
        "ar": "مرفوض مرة أخرى"
       }
      }
     ]
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "{\"detail\": [{"
      },
      {
       "text": "\"type\": \"missing\"",
       "color": "red",
       "label": {
        "en": "what went wrong",
        "ar": "نوع الخطأ"
       }
      },
      {
       "text": ", "
      },
      {
       "text": "\"loc\": [\"body\", \"price\"]",
       "color": "blue",
       "label": {
        "en": "where: body → price",
        "ar": "المكان: الجسم ← price"
       }
      },
      {
       "text": ", "
      },
      {
       "text": "\"msg\": \"Field required\"",
       "color": "yellow",
       "label": {
        "en": "human message",
        "ar": "رسالة مقروءة"
       }
      },
      {
       "text": ", "
      },
      {
       "text": "\"input\": {\"name\": \"Pen\"}",
       "color": "purple",
       "label": {
        "en": "what you sent",
        "ar": "ما أرسلته"
       }
      },
      {
       "text": "}]}"
      }
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "💥",
       "color": "red",
       "title": {
        "en": "Broken JSON",
        "ar": "JSON معطوب"
       },
       "text": {
        "en": "Trailing comma → `422` with `json_invalid`",
        "ar": "فاصلة زائدة ← `422` مع `json_invalid`"
       }
      },
      {
       "icon": "🫙",
       "color": "yellow",
       "title": {
        "en": "No body at all",
        "ar": "لا يوجد جسم"
       },
       "text": {
        "en": "`422`, `loc` is `[\"body\"]`, \"Field required\"",
        "ar": "`422`، و`loc` هو `[\"body\"]`، \"Field required\""
       }
      },
      {
       "icon": "🔢",
       "color": "green",
       "title": {
        "en": "Number as text",
        "ar": "رقم كنص"
       },
       "text": {
        "en": "`\"3\"` is converted to `3.0`",
        "ar": "`\"3\"` يُحوَّل إلى `3.0`"
       }
      },
      {
       "icon": "🗑️",
       "color": "blue",
       "title": {
        "en": "Extra fields",
        "ar": "حقول إضافية"
       },
       "text": {
        "en": "Undeclared fields are ignored by default",
        "ar": "الحقول غير المعرّفة تُتجاهَل افتراضيًا"
       }
      }
     ]
    },
    {
     "type": "warn",
     "en": "Pydantic v2: use `model_dump()`. The old `.dict()` is deprecated.",
     "ar": "في Pydantic v2 استخدم `model_dump()`. أما `.dict()` القديمة فهي مُهمَلة (deprecated)."
    }
   ]
  },
  {
   "id": "field-validation-nested",
   "title": {
    "en": "Field rules and nested models",
    "ar": "قواعد الحقول والنماذج المتداخلة"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "📏",
     "en": "Field() adds rules to each field",
     "ar": "Field() تضيف قواعد لكل حقل"
    },
    {
     "type": "code",
     "lang": "python",
     "code": "from pydantic import BaseModel, Field\n\n\nclass Product(BaseModel):\n    name: str = Field(min_length=2, max_length=20)\n    price: float = Field(gt=0)               # greater than 0\n    quantity: int = Field(default=1, ge=1)   # optional, at least 1",
     "highlight": [
      5,
      6,
      7
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "🔤",
       "color": "blue",
       "title": {
        "en": "min_length / max_length",
        "ar": "min_length / max_length"
       },
       "text": {
        "en": "Name has 2 to 20 characters",
        "ar": "الاسم من 2 إلى 20 حرفًا"
       }
      },
      {
       "icon": "🚫",
       "color": "red",
       "title": {
        "en": "gt=0",
        "ar": "gt=0"
       },
       "text": {
        "en": "Strictly greater than 0; `0` fails",
        "ar": "أكبر من 0 تمامًا، و`0` يفشل"
       }
      },
      {
       "icon": "⬆️",
       "color": "green",
       "title": {
        "en": "ge=1",
        "ar": "ge=1"
       },
       "text": {
        "en": "Greater than or equal to 1",
        "ar": "أكبر من أو يساوي 1"
       }
      },
      {
       "icon": "🎁",
       "color": "yellow",
       "title": {
        "en": "default=1",
        "ar": "default=1"
       },
       "text": {
        "en": "Field is optional, defaults to 1",
        "ar": "الحقل اختياري، وقيمته الافتراضية 1"
       }
      }
     ]
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "POST /products  {\"name\": \"Pen\", \"price\": 0}",
       "note": {
        "en": "breaks `gt=0`",
        "ar": "يخالف `gt=0`"
       }
      },
      {
       "from": "server",
       "text": "422  \"type\": \"greater_than\", \"msg\": \"Input should be greater than 0\"",
       "note": {
        "en": "rule caught it",
        "ar": "القاعدة اكتشفته"
       }
      }
     ]
    },
    {
     "type": "code",
     "lang": "python",
     "code": "class Order(BaseModel):\n    customer: str\n    products: list[Product]     # a JSON array of Product objects\n    tags: list[str] = []",
     "highlight": [
      3
     ]
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "\"loc\": ["
      },
      {
       "text": "\"body\"",
       "color": "blue",
       "label": {
        "en": "in the body",
        "ar": "في الجسم"
       }
      },
      {
       "text": ", "
      },
      {
       "text": "\"products\"",
       "color": "green",
       "label": {
        "en": "the list field",
        "ar": "حقل القائمة"
       }
      },
      {
       "text": ", "
      },
      {
       "text": "1",
       "color": "yellow",
       "label": {
        "en": "2nd item, counts from 0",
        "ar": "العنصر الثاني، العدّ من 0"
       }
      },
      {
       "text": ", "
      },
      {
       "text": "\"price\"",
       "color": "red",
       "label": {
        "en": "the bad field",
        "ar": "الحقل الخاطئ"
       }
      },
      {
       "text": "]"
      }
     ]
    },
    {
     "type": "tip",
     "en": "Inner models are validated too; errors point exactly to the bad item.",
     "ar": "النماذج الداخلية يُتحقق منها أيضًا، والخطأ يشير بدقة إلى العنصر الخاطئ."
    }
   ]
  },
  {
   "id": "body-path-query",
   "title": {
    "en": "Body, path and query together",
    "ar": "الجسم والمسار والاستعلام معًا"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🧭",
     "en": "Three sources, one endpoint",
     "ar": "ثلاثة مصادر في endpoint واحد"
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "PUT"
      },
      {
       "text": " /items/5",
       "color": "green",
       "label": {
        "en": "path → item_id",
        "ar": "المسار ← item_id"
       }
      },
      {
       "text": "?notify=true",
       "color": "yellow",
       "label": {
        "en": "query → notify",
        "ar": "الاستعلام ← notify"
       }
      },
      {
       "text": "\n\n"
      },
      {
       "text": "{\"name\": \"Pen\", \"price\": 3}",
       "color": "blue",
       "label": {
        "en": "body → item",
        "ar": "الجسم ← item"
       }
      }
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "🛣️",
       "color": "green",
       "title": {
        "en": "Path parameter",
        "ar": "معامل مسار"
       },
       "text": {
        "en": "Name appears in the path: `{item_id}`",
        "ar": "الاسم موجود في المسار: `{item_id}`"
       }
      },
      {
       "icon": "❓",
       "color": "yellow",
       "title": {
        "en": "Query parameter",
        "ar": "معامل استعلام"
       },
       "text": {
        "en": "Simple type like `int`, `bool`, not in path",
        "ar": "نوع بسيط مثل `int` أو `bool`، وليس في المسار"
       }
      },
      {
       "icon": "📦",
       "color": "blue",
       "title": {
        "en": "Request body",
        "ar": "جسم الطلب"
       },
       "text": {
        "en": "Type is a Pydantic model",
        "ar": "النوع نموذج Pydantic"
       }
      }
     ]
    },
    {
     "type": "code",
     "lang": "python",
     "code": "class Item(BaseModel):\n    name: str\n    price: float\n\n\n@app.put(\"/items/{item_id}\")\ndef update_item(item_id: int, item: Item, notify: bool = False):\n    return {\"item_id\": item_id, \"notify\": notify, \"item\": item.model_dump()}",
     "highlight": [
      6,
      7
     ]
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "PUT /items/5?notify=true  {\"name\": \"Pen\", \"price\": 3}"
      },
      {
       "from": "server",
       "text": "200 OK  {\"item_id\": 5, \"notify\": true, \"item\": {\"name\": \"Pen\", \"price\": 3.0}}",
       "note": {
        "en": "all three arrived",
        "ar": "الثلاثة وصلت"
       }
      }
     ]
    },
    {
     "type": "p",
     "en": "Parameter order in the function does not matter. FastAPI decides from each parameter.",
     "ar": "ترتيب المعاملات في الدالة لا يهم. FastAPI يقرر حسب كل معامل."
    },
    {
     "type": "pills",
     "items": [
      {
       "text": "[\"path\", \"item_id\"]",
       "color": "green",
       "label": {
        "en": "path failed",
        "ar": "فشل في المسار"
       }
      },
      {
       "text": "[\"query\", ...]",
       "color": "yellow",
       "label": {
        "en": "query failed",
        "ar": "فشل في الاستعلام"
       }
      },
      {
       "text": "[\"body\", ...]",
       "color": "blue",
       "label": {
        "en": "body failed",
        "ar": "فشل في الجسم"
       }
      }
     ]
    },
    {
     "type": "tip",
     "en": "Plain `text: str`, no default, not in path = REQUIRED query, not body. Use a model.",
     "ar": "المعامل `text: str` بلا قيمة افتراضية وليس في المسار = استعلام إلزامي، وليس جسمًا. استخدم نموذجًا."
    }
   ]
  },
  {
   "id": "responses",
   "title": {
    "en": "Shaping responses and errors",
    "ar": "تشكيل الاستجابات والأخطاء"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🛡️",
     "en": "Control exactly what goes back out",
     "ar": "تحكّم بالضبط فيما يخرج في الاستجابة"
    },
    {
     "type": "code",
     "lang": "python",
     "code": "class UserIn(BaseModel):\n    username: str\n    email: str\n    password: str\n\nclass UserOut(BaseModel):\n    username: str\n    email: str\n\n@app.post(\"/users\", response_model=UserOut, status_code=201)\ndef create_user(user: UserIn):\n    return user                      # password is filtered out",
     "highlight": [
      10,
      12
     ]
    },
    {
     "type": "compare",
     "left": {
      "title": {
       "en": "With response_model=UserOut",
       "ar": "مع response_model=UserOut"
      },
      "tone": "good",
      "items": [
       {
        "en": "Only `username` and `email` sent",
        "ar": "يُرسل `username` و`email` فقط"
       },
       {
        "en": "`password` is filtered out",
        "ar": "يُحذف `password`"
       }
      ]
     },
     "right": {
      "title": {
       "en": "Without response_model",
       "ar": "بدون response_model"
      },
      "tone": "bad",
      "items": [
       {
        "en": "Returns every field of `UserIn`",
        "ar": "يرجع كل حقول `UserIn`"
       },
       {
        "en": "`\"password\": \"s3cret\"` leaks out",
        "ar": "`\"password\": \"s3cret\"` يتسرّب"
       }
      ]
     }
    },
    {
     "type": "pills",
     "items": [
      {
       "text": "200",
       "color": "yellow",
       "label": {
        "en": "default success",
        "ar": "النجاح الافتراضي"
       }
      },
      {
       "text": "201",
       "color": "green",
       "label": {
        "en": "Created, with status_code=201",
        "ar": "Created، مع status_code=201"
       }
      },
      {
       "text": "422",
       "color": "red",
       "label": {
        "en": "invalid input",
        "ar": "مدخلات غير صالحة"
       }
      },
      {
       "text": "404",
       "color": "purple",
       "label": {
        "en": "raised HTTPException",
        "ar": "HTTPException مرفوع"
       }
      }
     ]
    },
    {
     "type": "code",
     "lang": "python",
     "code": "@app.get(\"/users/{username}\", response_model=UserOut)\ndef get_user(username: str):\n    if username not in fake_db:\n        raise HTTPException(status_code=404, detail=\"User not found\")\n    return fake_db[username]",
     "highlight": [
      4
     ]
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "POST /users  {\"username\": \"ali\", \"email\": \"ali@example.com\", \"password\": \"s3cret\"}",
       "note": {
        "en": "valid new user",
        "ar": "مستخدم جديد صالح"
       }
      },
      {
       "from": "server",
       "text": "201 Created  {\"username\": \"ali\", \"email\": \"ali@example.com\"}",
       "note": {
        "en": "password hidden",
        "ar": "كلمة المرور مخفية"
       }
      },
      {
       "from": "client",
       "text": "POST /users  {\"username\": \"ali\"}",
       "note": {
        "en": "fields missing",
        "ar": "حقول ناقصة"
       }
      },
