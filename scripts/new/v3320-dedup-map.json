  "questions-cyber.json": {
    "111": {
      "category": "nmap",
      "difficulty": "medium",
      "codeSnippet": "nmap -sT 10.0.0.5",
      "question": {
        "en": "What is a -sT connect scan?"
      },
      "options": [
        "Full TCP handshake",
        "Raw SYN probe only",
        "A UDP port sweep",
        "An ICMP echo ping"
      ],
      "answer": "Full TCP handshake",
      "explanation": {
        "en": "It completes the handshake, so it needs no root but is easier for the target to log."
      }
    },
    "178": {
      "category": "nmap",
      "difficulty": "hard",
      "codeSnippet": "nmap -sA 10.0.0.5",
      "question": {
        "en": "What does an -sA ACK scan map?"
      },
      "options": [
        "Firewall filtering rules",
        "Running service versions",
        "The target's OS",
        "Open UDP ports"
      ],
      "answer": "Firewall filtering rules",
      "explanation": {
        "en": "It cannot tell open from closed, but which ACKs are dropped reveals whether a port is filtered."
      }
    },
    "112": {
      "category": "nmap",
      "difficulty": "medium",
      "codeSnippet": "nmap -6 ::1",
      "question": {
        "en": "What does the -6 flag enable?"
      },
      "options": [
        "Scanning an IPv6 host",
        "Six parallel probes",
        "Layer-6 inspection",
        "A six-second timeout"
      ],
      "answer": "Scanning an IPv6 host",
      "explanation": {
        "en": "Without it nmap assumes IPv4; the target must be given as an IPv6 address."
      }
    },
