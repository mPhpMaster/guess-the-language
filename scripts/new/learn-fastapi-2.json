     "items": [
      {
       "en": "Open http://127.0.0.1:8000/docs",
       "ar": "افتح http://127.0.0.1:8000/docs"
      },
      {
       "en": "Click an endpoint, e.g. `GET /`",
       "ar": "اضغط على endpoint، مثل `GET /`"
      },
      {
       "en": "Click \"Try it out\", then \"Execute\"",
       "ar": "اضغط \"Try it out\" ثم \"Execute\""
