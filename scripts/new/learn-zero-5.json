        "ar": "أغلق صندوق الأدوات"
       }
      },
      {
       "from": "server",
       "text": "C:\\shop>",
       "note": {
        "en": "back to normal",
        "ar": "عدنا للوضع العادي"
       }
      }
     ]
    },
    {
     "type": "tip",
     "en": "Activate the venv again each time you open a new terminal.",
     "ar": "فعّل الـ venv من جديد كلما فتحت طرفية جديدة."
    }
   ]
  }
 ],
 "quiz": [
  {
   "id": 1,
   "difficulty": "easy",
   "question": {
    "en": "In the Windows Python installer, which option should you tick?",
    "ar": "في مثبِّت Python على Windows، أي خيار يجب أن تفعّله؟"
   },
   "codeSnippet": "",
   "options": [
    {
     "en": "Use admin privileges only",
     "ar": "Use admin privileges only"
    },
    {
     "en": "Disable path length limit",
     "ar": "Disable path length limit"
    },
    {
     "en": "Add python.exe to PATH",
     "ar": "Add python.exe to PATH"
    },
    {
     "en": "Install for all users",
     "ar": "Install for all users"
    }
   ],
   "answer": 2,
   "explanation": {
    "en": "Ticking \"Add python.exe to PATH\" lets Windows find the `python` command in the terminal.",
    "ar": "تفعيل \"Add python.exe to PATH\" يجعل Windows يجد الأمر `python` في الطرفية."
   }
  },
  {
   "id": 2,
   "difficulty": "easy",
   "question": {
    "en": "You type this at the Python prompt. What does Python show?",
    "ar": "كتبت هذا في موجّه Python. ماذا يعرض Python؟"
   },
   "codeSnippet": ">>> 7 * 6",
