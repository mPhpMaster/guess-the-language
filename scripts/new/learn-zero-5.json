  {
   "id": "virtual-envs",
   "title": {
    "en": "Virtual environments",
    "ar": "البيئات الافتراضية (virtual environments)"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🧰",
     "en": "A separate toolbox for each project",
     "ar": "صندوق أدوات منفصل لكل مشروع"
    },
    {
     "type": "compare",
     "left": {
      "title": {
       "en": "Without a venv",
       "ar": "بدون venv"
      },
      "tone": "bad",
      "items": [
       {
        "en": "All projects share one toolbox",
        "ar": "كل المشاريع تشترك في صندوق واحد"
       },
       {
        "en": "One upgrade can break another project",
        "ar": "تحديث واحد قد يُعطّل مشروعًا آخر"
       }
      ]
     },
     "right": {
      "title": {
       "en": "With a venv",
       "ar": "مع venv"
      },
      "tone": "good",
      "items": [
       {
        "en": "Each project has its own `.venv`",
        "ar": "لكل مشروع مجلد `.venv` خاص به"
       },
       {
        "en": "Projects cannot break each other",
        "ar": "المشاريع لا تُعطّل بعضها"
       }
      ]
     }
    },
    {
     "type": "steps",
     "items": [
      {
       "en": "`cd` into your project folder",
       "ar": "ادخل مجلد مشروعك بـ `cd`"
      },
      {
       "en": "Create it: `python -m venv .venv`",
       "ar": "أنشئها: `python -m venv .venv`"
      },
      {
       "en": "Activate it (see below)",
       "ar": "فعّلها (انظر بالأسفل)"
      },
      {
       "en": "Install: `pip install requests`",
       "ar": "ثبّت: `pip install requests`"
      },
      {
       "en": "Finished? Type `deactivate`",
       "ar": "انتهيت؟ اكتب `deactivate`"
      }
     ]
    },
    {
     "type": "compare",
     "left": {
      "title": {
       "en": "Windows",
       "ar": "Windows"
      },
      "tone": "neutral",
      "items": [
       {
        "en": "`python -m venv .venv`",
        "ar": "`python -m venv .venv`"
       },
       {
        "en": "`.venv\\Scripts\\activate`",
        "ar": "`.venv\\Scripts\\activate`"
       }
      ]
     },
     "right": {
      "title": {
       "en": "macOS / Linux",
       "ar": "macOS / Linux"
      },
      "tone": "neutral",
      "items": [
       {
        "en": "`python3 -m venv .venv`",
        "ar": "`python3 -m venv .venv`"
       },
       {
        "en": "`source .venv/bin/activate`",
        "ar": "`source .venv/bin/activate`"
       }
      ]
     }
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "C:\\shop> .venv\\Scripts\\activate",
       "note": {
        "en": "open the toolbox",
        "ar": "افتح صندوق الأدوات"
       }
      },
      {
       "from": "server",
       "text": "(.venv) C:\\shop>",
       "note": {
        "en": "`(.venv)` means it is active",
        "ar": "`(.venv)` تعني أنها مفعّلة"
