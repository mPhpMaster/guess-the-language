 "quiz": [
  {
   "id": 1,
   "difficulty": "easy",
   "question": {
    "en": "In the restaurant picture, what is the API?",
    "ar": "في صورة المطعم، ما هو الـ API؟"
   },
   "codeSnippet": "",
   "options": [
    {
     "en": "The kitchen that cooks every dish",
     "ar": "المطبخ الذي يطبخ كل الأطباق"
    },
    {
     "en": "The waiter who carries the orders",
     "ar": "النادل الذي ينقل الطلبات"
    },
    {
     "en": "The hungry customer placing an order",
     "ar": "الزبون الجائع الذي يطلب"
    },
    {
     "en": "The table where everyone sits",
     "ar": "الطاولة التي يجلس عليها الجميع"
    }
   ],
   "answer": 1,
   "explanation": {
