{
 "id": "first-api",
 "icon": "🎉",
 "title": {
  "en": "Your first API in 10 minutes",
  "ar": "أول API لك في 10 دقائق"
 },
 "summary": {
  "en": "Use everything you learned to build and run a tiny FastAPI app.",
  "ar": "استخدم كل ما تعلمته لتبني تطبيق FastAPI صغيرًا وتشغّله."
 },
 "lessons": [
  {
   "id": "api-is-a-waiter",
   "title": {
    "en": "An API is a waiter",
    "ar": "الـ API نادل بين البرامج"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🤵",
     "en": "An API is a waiter between programs",
     "ar": "الـ API نادل يتنقّل بين البرامج"
    },
    {
     "type": "flow",
     "nodes": [
      {
       "icon": "📱",
       "label": {
        "en": "Program A (customer)",
        "ar": "البرنامج A (الزبون)"
       }
      },
      {
       "icon": "🤵",
       "label": {
        "en": "API (waiter)",
        "ar": "الـ API (النادل)"
       }
      },
      {
       "icon": "🧑‍🍳",
       "label": {
        "en": "Program B (kitchen)",
        "ar": "البرنامج B (المطبخ)"
       }
      }
     ],
     "links": [
      {
       "label": {
        "en": "order",
        "ar": "الطلب"
       }
      },
      {
       "label": {
        "en": "passes it on",
        "ar": "ينقله للمطبخ"
       }
      }
     ]
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "GET /",
       "note": {
        "en": "one greeting, please!",
        "ar": "تحية واحدة من فضلك!"
       }
      },
      {
       "from": "server",
       "text": "{\"message\": \"Hello, Sara!\"}",
       "note": {
        "en": "here is your dish",
        "ar": "تفضّل طبقك"
       }
      }
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "📜",
       "color": "blue",
       "title": {
        "en": "Menu = endpoints",
        "ar": "القائمة = الـ endpoints"
       },
       "text": {
        "en": "What you are allowed to ask for",
        "ar": "ما يُسمح لك أن تطلبه"
       }
      },
      {
       "icon": "📝",
       "color": "yellow",
       "title": {
        "en": "Order = request",
        "ar": "الطلب = request"
       },
       "text": {
        "en": "What the customer asks",
        "ar": "ما يطلبه الزبون"
       }
      },
      {
       "icon": "🍲",
       "color": "green",
       "title": {
        "en": "Dish = response",
        "ar": "الطبق = response"
       },
       "text": {
        "en": "What comes back, usually JSON",
        "ar": "ما يعود إليك، غالبًا JSON"
       }
      }
     ]
    },
    {
     "type": "tip",
     "en": "Today YOU build the waiter. It takes about 10 minutes!",
     "ar": "اليوم أنت من سيبني النادل. يستغرق ذلك نحو 10 دقائق فقط!"
    }
   ]
  },
  {
   "id": "get-ready",
   "title": {
    "en": "Folder, venv, install",
    "ar": "مجلد وvenv وتثبيت"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "📁",
     "en": "Three minutes of setup, then the fun starts",
     "ar": "ثلاث دقائق تجهيز، ثم تبدأ المتعة"
    },
    {
     "type": "steps",
     "items": [
      {
       "en": "Make a folder: `mkdir hello-api`",
       "ar": "أنشئ مجلدًا: `mkdir hello-api`"
      },
      {
       "en": "Go inside: `cd hello-api`",
       "ar": "ادخل إليه: `cd hello-api`"
      },
      {
       "en": "Create a venv: `python -m venv .venv`",
       "ar": "أنشئ venv: `python -m venv .venv`"
      },
      {
       "en": "Activate it (see below)",
       "ar": "فعّله (انظر بالأسفل)"
      },
      {
       "en": "Install FastAPI with `pip`",
       "ar": "ثبّت FastAPI باستخدام `pip`"
      }
     ]
    },
    {
     "type": "code",
     "lang": "bash",
     "code": "mkdir hello-api\ncd hello-api\npython -m venv .venv\n.venv\\Scripts\\activate\npip install \"fastapi[standard]\"",
     "highlight": [
      5
     ]
    },
    {
     "type": "compare",
     "left": {
      "title": {
       "en": "Windows",
       "ar": "Windows"
      },
      "tone": "neutral",
      "items": [
       {
        "en": "`python -m venv .venv`",
        "ar": "`python -m venv .venv`"
       },
       {
        "en": "`.venv\\Scripts\\activate`",
        "ar": "`.venv\\Scripts\\activate`"
       }
      ]
     },
     "right": {
      "title": {
       "en": "macOS / Linux",
       "ar": "macOS / Linux"
      },
      "tone": "neutral",
      "items": [
       {
        "en": "`python3 -m venv .venv`",
        "ar": "`python3 -m venv .venv`"
       },
       {
        "en": "`source .venv/bin/activate`",
        "ar": "`source .venv/bin/activate`"
       }
      ]
     }
    },
    {
     "type": "tip",
     "en": "See `(.venv)` at the start of your prompt? The venv is active.",
     "ar": "هل ترى `(.venv)` في بداية سطر الأوامر؟ إذن الـ venv مفعّل."
    }
   ]
  },
  {
   "id": "hello-api",
   "title": {
    "en": "Six lines, one API",
    "ar": "ستة أسطر، API واحدة"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "👋",
     "en": "Create main.py and say hello",
     "ar": "أنشئ main.py وقل مرحبًا"
    },
    {
     "type": "code",
     "lang": "python",
     "code": "from fastapi import FastAPI\napp = FastAPI()\n\n@app.get(\"/\")\ndef home():\n    return {\"message\": \"Hello, Sara!\"}",
     "highlight": [
      4,
      5,
      6
     ]
    },
    {
     "type": "code",
     "lang": "text",
     "code": "> fastapi dev main.py\n\n Server started at http://127.0.0.1:8000\n Documentation at http://127.0.0.1:8000/docs",
     "highlight": [
      3,
      4
     ]
    },
    {
     "type": "flow",
     "nodes": [
      {
       "icon": "🌍",
       "label": {
        "en": "Your browser",
        "ar": "متصفحك"
       }
      },
      {
       "icon": "🐍",
       "label": {
        "en": "Your FastAPI app",
        "ar": "تطبيق FastAPI الخاص بك"
       }
      }
     ],
     "links": [
      {
       "label": {
        "en": "GET /",
        "ar": "GET /"
       }
      }
     ],
     "returns": {
      "en": "{\"message\": ...}",
      "ar": "{\"message\": ...}"
     }
    },
    {
     "type": "pills",
     "items": [
      {
       "text": "http://127.0.0.1:8000",
       "color": "green",
       "label": {
        "en": "your greeting",
        "ar": "تحيتك"
       }
      },
      {
       "text": "http://127.0.0.1:8000/docs",
       "color": "purple",
       "label": {
        "en": "free docs page",
        "ar": "صفحة توثيق مجانية"
