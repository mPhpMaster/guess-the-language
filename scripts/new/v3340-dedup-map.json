  "questions-cyber.json": {
    "100": {
      "category": "crypto",
      "difficulty": "hard",
      "codeSnippet": "",
      "question": {
        "en": "What does key stretching do to a password?"
      },
      "options": [
        "Makes hashing costly",
        "Adds a random salt",
        "Encrypts it at rest",
        "Shortens the digest"
      ],
      "answer": "Makes hashing costly",
      "explanation": {
        "en": "Functions like PBKDF2 or Argon2 repeat the work so each guess is expensive for an attacker."
      }
    },
    "234": {
      "category": "crypto",
      "difficulty": "medium",
      "codeSnippet": "",
      "question": {
        "en": "What is a pepper in password hashing?"
      },
      "options": [
        "A secret kept apart",
        "A per-user random salt",
        "A slower hash round",
        "A longer output digest"
      ],
      "answer": "A secret kept apart",
      "explanation": {
        "en": "Unlike the salt, a pepper is stored outside the database, so a dump alone cannot verify guesses."
      }
    }
  },
