  "questions-network.json": {
    "42": {
      "category": "ip",
      "difficulty": "medium",
      "codeSnippet": "",
      "question": {
        "en": "What is 255.255.255.255 used for?"
      },
      "options": [
        "A limited broadcast",
        "A loopback test",
        "A default route",
        "A subnet mask"
      ],
      "answer": "A limited broadcast",
      "explanation": {
        "en": "It reaches every host on the local link and is never forwarded by a router."
      }
    },
    "114": {
      "category": "addressing",
      "difficulty": "medium",
      "codeSnippet": "",
      "question": {
        "en": "What does a /32 prefix describe?"
      },
      "options": [
        "A single host route",
        "A whole subnet",
        "A private range",
        "A multicast group"
      ],
      "answer": "A single host route",
      "explanation": {
        "en": "All 32 bits are fixed, so it matches exactly one address — used for host routes and loopbacks."
      }
    },
    "58": {
      "category": "ip",
      "difficulty": "medium",
      "codeSnippet": "",
      "question": {
        "en": "How many usable hosts does a /25 have?"
      },
      "options": [
        "126",
        "128",
        "254",
        "62"
      ],
      "answer": "126",
      "explanation": {
        "en": "A /25 has 128 addresses; subtracting the network and broadcast leaves 126 usable."
      }
    },
    "76": {
      "category": "ip",
      "difficulty": "hard",
      "codeSnippet": "",
      "question": {
        "en": "How many /26 subnets fit in a /24?"
      },
      "options": [
        "4",
        "2",
        "8",
        "16"
      ],
      "answer": "4",
      "explanation": {
        "en": "Borrowing two host bits (/24 to /26) yields 2 squared, which is four equal subnets."
      }
    },
