      "codeSnippet": "",
      "question": {
        "en": "What does the route 0.0.0.0/0 mean?"
      },
      "options": [
        "The default route",
        "A blocked network",
        "The local subnet",
        "A loopback route"
      ],
      "answer": "The default route",
      "explanation": {
