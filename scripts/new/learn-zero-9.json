  {
   "id": "json-files",
   "title": {
    "en": "Saving and loading a .json file",
    "ar": "حفظ ملف ‎.json وقراءته"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "💾",
     "en": "A .json file is a notebook",
     "ar": "ملف ‎.json مثل دفتر ملاحظات"
    },
    {
     "type": "steps",
     "items": [
      {
       "en": "Open the file with `\"w\"` (write)",
       "ar": "افتح الملف بـ `\"w\"` (كتابة)"
      },
      {
       "en": "Save data: `json.dump(data, f)`",
       "ar": "احفظ البيانات: `json.dump(data, f)`"
      },
      {
       "en": "Later, open it again to read",
       "ar": "لاحقًا، افتحه مجددًا للقراءة"
      },
      {
       "en": "Load data: `json.load(f)`",
       "ar": "اقرأ البيانات: `json.load(f)`"
      }
     ]
    },
    {
     "type": "code",
     "lang": "python",
     "code": "import json\nscores = {\"Sara\": 90, \"Ali\": 75}\nwith open(\"scores.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(scores, f, indent=2)\n\nwith open(\"scores.json\", encoding=\"utf-8\") as f:\n    data = json.load(f)\nprint(data[\"Sara\"])   # 90",
     "highlight": [
      4,
      7
     ]
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "with",
       "color": "blue",
       "label": {
        "en": "closes the file for you",
        "ar": "يغلق الملف عنك"
       }
      },
      {
       "text": " open("
      },
      {
       "text": "\"scores.json\"",
       "color": "green",
       "label": {
        "en": "file name",
        "ar": "اسم الملف"
       }
      },
      {
       "text": ", "
      },
      {
       "text": "\"w\"",
       "color": "yellow",
       "label": {
        "en": "mode: write",
        "ar": "الوضع: كتابة"
       }
      },
      {
       "text": ", "
      },
      {
       "text": "encoding=\"utf-8\"",
       "color": "cyan",
       "label": {
        "en": "keeps Arabic safe",
        "ar": "يحفظ العربية سليمة"
       }
      },
      {
       "text": ") "
      },
      {
       "text": "as f",
       "color": "purple",
       "label": {
        "en": "f = the open file",
        "ar": "f = الملف المفتوح"
       }
      },
      {
       "text": ":"
      }
     ]
    },
    {
     "type": "compare",
     "left": {
      "title": {
       "en": "No `s`: a file",
       "ar": "بدون `s`: ملف"
      },
      "tone": "neutral",
      "items": [
       {
        "en": "`json.dump(data, f)` writes to file",
        "ar": "`json.dump(data, f)` يكتب في ملف"
       },
       {
        "en": "`json.load(f)` reads from file",
        "ar": "`json.load(f)` يقرأ من ملف"
       }
      ]
     },
     "right": {
      "title": {
       "en": "With `s`: a string",
       "ar": "مع `s`: نص"
      },
      "tone": "neutral",
      "items": [
       {
        "en": "`json.dumps(data)` gives text",
        "ar": "`json.dumps(data)` يعطيك نصًا"
       },
       {
        "en": "`json.loads(text)` reads text",
        "ar": "`json.loads(text)` يقرأ نصًا"
       }
      ]
     }
    },
    {
     "type": "warn",
     "en": "Mode `\"w\"` wipes the old file first. Reading needs no mode (it is `\"r\"`).",
     "ar": "الوضع `\"w\"` يمسح الملف القديم أولًا. القراءة لا تحتاج وضعًا (فهو `\"r\"`)."
    }
   ]
