{
 "id": "web-basics",
 "icon": "🌐",
 "title": {
  "en": "Web basics: HTTP, APIs and JSON",
  "ar": "أساسيات الويب: HTTP والـ APIs والـ JSON"
 },
 "summary": {
  "en": "Learn how clients and servers talk with HTTP requests, responses, status codes and JSON before writing any FastAPI code.",
  "ar": "تعلّم كيف يتواصل العميل والخادم عبر طلبات HTTP واستجاباتها ورموز الحالة والـ JSON قبل كتابة أي كود FastAPI."
 },
 "lessons": [
  {
   "id": "clients-servers-requests",
   "title": {
    "en": "Clients, servers and the HTTP request",
    "ar": "العميل والخادم وطلب HTTP"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🌐",
     "en": "An API lets one program ask another",
     "ar": "الـ API تسمح لبرنامج أن يطلب من برنامج آخر"
    },
    {
     "type": "flow",
     "nodes": [
      {
       "icon": "💻",
       "label": {
        "en": "Client (browser, app)",
        "ar": "العميل (متصفح، تطبيق)"
       }
      },
      {
       "icon": "🖥️",
       "label": {
        "en": "Server",
        "ar": "الخادم"
       }
      }
     ],
     "links": [
      {
       "label": {
        "en": "request",
        "ar": "طلب (request)"
       }
      }
     ],
     "returns": {
      "en": "response",
      "ar": "استجابة (response)"
     }
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "🎯",
       "color": "blue",
       "title": {
        "en": "Method",
        "ar": "الـ method"
       },
       "text": {
        "en": "The action, e.g. `GET` or `POST`",
        "ar": "الفعل المطلوب، مثل `GET` أو `POST`"
       }
      },
      {
       "icon": "📍",
       "color": "green",
       "title": {
        "en": "URL",
        "ar": "الـ URL"
       },
       "text": {
        "en": "Which resource you want",
        "ar": "أي مورد تقصده"
       }
      },
      {
       "icon": "🏷️",
       "color": "cyan",
       "title": {
        "en": "Headers",
        "ar": "الـ headers"
       },
       "text": {
        "en": "Extra info as `Name: value` lines",
        "ar": "معلومات إضافية كأسطر `Name: value`"
       }
      },
      {
       "icon": "📦",
       "color": "yellow",
       "title": {
        "en": "Body",
        "ar": "الـ body"
       },
       "text": {
        "en": "Optional data sent, often JSON",
        "ar": "بيانات اختيارية تُرسل، غالبًا JSON"
       }
      }
     ]
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "POST",
       "color": "blue",
       "label": {
        "en": "method",
        "ar": "الـ method"
       }
      },
      {
       "text": " "
      },
      {
       "text": "/users",
       "color": "green",
       "label": {
        "en": "path",
        "ar": "المسار (path)"
       }
      },
      {
       "text": "?notify=true",
       "color": "yellow",
       "label": {
        "en": "query string",
        "ar": "الـ query string"
       }
      },
      {
       "text": " "
      },
      {
       "text": "HTTP/1.1",
       "color": "purple",
       "label": {
        "en": "HTTP version",
        "ar": "إصدار HTTP"
       }
      },
      {
       "text": "\n"
      },
      {
       "text": "Host: api.example.com\nContent-Type: application/json\nAccept: application/json",
       "color": "cyan",
       "label": {
        "en": "headers",
        "ar": "الـ headers"
       }
      },
      {
       "text": "\n\n"
      },
      {
       "text": "{\"name\": \"Sara\", \"age\": 25}",
       "color": "red",
       "label": {
        "en": "body (after empty line)",
        "ar": "الـ body (بعد سطر فارغ)"
       }
      }
     ]
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "https",
       "color": "purple",
       "label": {
        "en": "scheme",
        "ar": "الـ scheme"
       }
      },
      {
       "text": "://"
      },
      {
       "text": "api.example.com",
       "color": "blue",
       "label": {
        "en": "host",
        "ar": "الـ host"
       }
      },
      {
       "text": "/users",
       "color": "green",
       "label": {
        "en": "path",
        "ar": "المسار (path)"
       }
      },
      {
       "text": "?"
      },
      {
       "text": "page=2&limit=10",
       "color": "yellow",
       "label": {
        "en": "query string",
        "ar": "الـ query string"
       }
      }
     ]
    },
    {
     "type": "tip",
     "en": "`Content-Type` = body format sent. `Accept` = format wanted back.",
     "ar": "الـ `Content-Type` = صيغة الـ body المُرسل. والـ `Accept` = الصيغة المطلوبة في الرد."
    },
    {
     "type": "tip",
     "en": "Query string: `key=value` pairs after `?`, joined by `&`. Used for filters, search, paging.",
     "ar": "الـ query string: أزواج `key=value` بعد `?` مفصولة بـ `&`. للتصفية والبحث وتقسيم الصفحات."
    }
   ]
  },
  {
   "id": "http-response-status-codes",
   "title": {
    "en": "The response and status codes",
    "ar": "الاستجابة ورموز الحالة"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🚦",
     "en": "Every request gets a response with a status code",
     "ar": "كل طلب يحصل على استجابة فيها رمز حالة"
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "GET /users/42",
       "note": {
        "en": "asks for user 42",
        "ar": "يطلب المستخدم 42"
       }
      },
      {
       "from": "server",
       "text": "200 OK  {\"id\": 42, \"name\": \"Sara\"}",
       "note": {
        "en": "here it is",
        "ar": "تفضّل"
       }
      },
      {
       "from": "client",
       "text": "GET /users/999",
       "note": {
        "en": "asks for a missing user",
        "ar": "يطلب مستخدمًا غير موجود"
       }
      },
      {
       "from": "server",
       "text": "404 Not Found  {\"detail\": \"Not Found\"}",
       "note": {
        "en": "nothing there",
        "ar": "لا يوجد شيء"
       }
      }
     ]
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "HTTP/1.1",
       "color": "purple",
       "label": {
        "en": "HTTP version",
        "ar": "إصدار HTTP"
       }
      },
      {
       "text": " "
      },
      {
       "text": "200",
       "color": "green",
       "label": {
        "en": "status code",
        "ar": "رمز الحالة (status code)"
       }
      },
      {
       "text": " "
      },
      {
       "text": "OK",
       "color": "cyan",
       "label": {
        "en": "reason phrase",
        "ar": "العبارة القصيرة"
       }
      },
      {
       "text": "\n"
      },
      {
       "text": "Content-Type: application/json",
       "color": "blue",
       "label": {
        "en": "headers",
        "ar": "الـ headers"
       }
      },
      {
       "text": "\n\n"
      },
      {
       "text": "{\"id\": 42, \"name\": \"Sara\"}",
       "color": "yellow",
       "label": {
        "en": "body (optional)",
        "ar": "الـ body (اختياري)"
       }
      }
     ]
    },
    {
     "type": "pills",
     "items": [
      {
       "text": "2xx",
       "color": "green",
       "label": {
        "en": "success",
        "ar": "نجاح"
       }
      },
      {
       "text": "3xx",
       "color": "cyan",
       "label": {
        "en": "redirect",
        "ar": "إعادة توجيه"
       }
      },
      {
       "text": "4xx",
       "color": "yellow",
       "label": {
        "en": "client error",
        "ar": "خطأ من العميل"
       }
      },
      {
       "text": "5xx",
       "color": "red",
       "label": {
        "en": "server error",
        "ar": "خطأ في الخادم"
       }
      }
     ]
    },
    {
     "type": "pills",
     "items": [
      {
       "text": "200",
       "color": "green",
       "label": {
        "en": "OK",
        "ar": "OK"
       }
      },
      {
       "text": "201",
       "color": "green",
       "label": {
        "en": "Created",
        "ar": "Created (تم الإنشاء)"
       }
      },
      {
       "text": "204",
       "color": "green",
       "label": {
        "en": "No Content (empty body)",
        "ar": "No Content (بدون body)"
       }
      },
      {
       "text": "301",
       "color": "cyan",
       "label": {
        "en": "Moved Permanently",
        "ar": "Moved Permanently (نُقل نهائيًا)"
       }
      },
      {
       "text": "400",
       "color": "yellow",
       "label": {
        "en": "Bad Request",
        "ar": "Bad Request"
       }
      },
      {
       "text": "404",
       "color": "yellow",
       "label": {
        "en": "Not Found",
        "ar": "Not Found (غير موجود)"
       }
      },
      {
       "text": "422",
       "color": "red",
       "label": {
        "en": "Unprocessable Content",
        "ar": "Unprocessable Content"
       }
      },
      {
       "text": "500",
       "color": "red",
       "label": {
        "en": "Internal Server Error",
        "ar": "Internal Server Error"
       }
      }
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "🔑",
       "color": "yellow",
       "title": {
        "en": "`401` Unauthorized",
        "ar": "`401` Unauthorized"
       },
       "text": {
        "en": "Server does not know who you are",
        "ar": "الخادم لا يعرف من أنت"
       }
      },
      {
       "icon": "⛔",
       "color": "red",
       "title": {
        "en": "`403` Forbidden",
        "ar": "`403` Forbidden"
       },
       "text": {
        "en": "Server knows you, but you are not allowed",
        "ar": "الخادم يعرفك، لكنك غير مسموح لك"
       }
      },
      {
       "icon": "🧩",
       "color": "yellow",
       "title": {
        "en": "`400` Bad Request",
        "ar": "`400` Bad Request"
       },
       "text": {
        "en": "The request itself is malformed",
        "ar": "الطلب نفسه معطوب"
       }
      },
      {
       "icon": "🧪",
       "color": "red",
       "title": {
        "en": "`422` Unprocessable Content",
        "ar": "`422` Unprocessable Content"
       },
       "text": {
        "en": "Readable, but data invalid. FastAPI validation errors.",
        "ar": "مقروء لكن البيانات غير صالحة. أخطاء التحقق في FastAPI."
       }
      }
     ]
    },
    {
     "type": "tip",
     "en": "4xx: the client should change the request. 5xx: the server has a problem.",
     "ar": "الـ 4xx: على العميل تعديل طلبه. الـ 5xx: المشكلة في الخادم."
    }
   ]
  },
  {
   "id": "methods-and-rest-urls",
   "title": {
    "en": "HTTP methods and REST-style URLs",
    "ar": "الـ HTTP methods وروابط نمط REST"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🛠️",
     "en": "The URL is the noun, the method the verb",
     "ar": "الـ URL هو الاسم، والـ method هي الفعل"
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "👀",
       "color": "blue",
       "title": {
        "en": "`GET`",
        "ar": "`GET`"
       },
       "text": {
        "en": "Read data. No body.",
        "ar": "قراءة البيانات، بدون body."
       }
      },
      {
       "icon": "✨",
       "color": "green",
       "title": {
        "en": "`POST`",
        "ar": "`POST`"
       },
       "text": {
        "en": "Create a new item; server picks the id",
        "ar": "إنشاء عنصر جديد، والخادم يختار الـ id"
       }
      },
      {
       "icon": "🔄",
       "color": "yellow",
       "title": {
        "en": "`PUT`",
        "ar": "`PUT`"
       },
       "text": {
        "en": "Replace the whole item",
        "ar": "استبدال العنصر كاملًا"
       }
      },
      {
       "icon": "🩹",
       "color": "purple",
       "title": {
        "en": "`PATCH`",
        "ar": "`PATCH`"
       },
       "text": {
        "en": "Change only some fields",
        "ar": "تعديل بعض الحقول فقط"
       }
      },
      {
       "icon": "🗑️",
       "color": "red",
       "title": {
        "en": "`DELETE`",
        "ar": "`DELETE`"
       },
       "text": {
        "en": "Remove an item",
        "ar": "حذف عنصر"
       }
      }
     ]
    },
    {
     "type": "code",
     "lang": "text",
     "code": "GET    /users        list all users\nPOST   /users        create a user\nGET    /users/42     read user 42\nPUT    /users/42     replace user 42\nPATCH  /users/42     update some fields of user 42\nDELETE /users/42     delete user 42",
     "highlight": [
      1,
      3
     ]
    },
    {
     "type": "compare",
     "left": {
      "title": {
       "en": "REST style",
       "ar": "نمط REST"
      },
      "tone": "good",
      "items": [
       {
        "en": "`GET /users/42`",
        "ar": "`GET /users/42`"
       },
       {
        "en": "`DELETE /users/42`",
        "ar": "`DELETE /users/42`"
       },
       {
        "en": "Plural collection: `/users`",
        "ar": "المجموعة بالجمع: `/users`"
       }
      ]
     },
     "right": {
      "title": {
       "en": "Verbs in URLs",
       "ar": "أفعال في الروابط"
      },
      "tone": "bad",
      "items": [
       {
        "en": "`/getUser`",
        "ar": "`/getUser`"
       },
       {
        "en": "`/deleteUser`",
        "ar": "`/deleteUser`"
       }
      ]
     }
    },
    {
     "type": "p",
     "en": "Safe: only reads, never changes data. Idempotent: same final result, sent once or many times.",
     "ar": "الآمنة (safe): تقرأ فقط ولا تغيّر البيانات. متساوية الأثر (idempotent): النتيجة النهائية نفسها مهما تكرر الإرسال."
    },
    {
     "type": "pills",
     "items": [
      {
       "text": "GET",
       "color": "green",
       "label": {
        "en": "safe + idempotent",
        "ar": "safe + idempotent"
       }
      },
      {
       "text": "PUT",
       "color": "cyan",
       "label": {
        "en": "idempotent",
        "ar": "idempotent"
       }
      },
      {
       "text": "DELETE",
       "color": "cyan",
       "label": {
        "en": "idempotent",
        "ar": "idempotent"
       }
      },
      {
       "text": "PATCH",
       "color": "yellow",
       "label": {
        "en": "not guaranteed idempotent",
        "ar": "ليست مضمونة idempotent"
       }
      },
      {
       "text": "POST",
       "color": "red",
       "label": {
        "en": "not idempotent",
        "ar": "ليست idempotent"
       }
      }
     ]
    },
    {
     "type": "warn",
     "en": "Sending the same `POST /users` twice usually creates two users.",
     "ar": "إرسال `POST /users` نفسه مرتين ينشئ غالبًا مستخدمَين."
    }
   ]
  },
  {
   "id": "json-basics",
   "title": {
    "en": "JSON: the language of APIs",
    "ar": "الـ JSON: لغة الـ APIs"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "📦",
     "en": "JSON: the text format APIs speak",
     "ar": "الـ JSON: الصيغة النصية التي تتكلمها الـ APIs"
    },
    {
     "type": "code",
     "lang": "json",
     "code": "{\n  \"id\": 42,\n  \"name\": \"Sara\",\n  \"age\": 25,\n  \"is_admin\": false,\n  \"height\": 1.68,\n  \"tags\": [\"python\", \"api\"],\n  \"address\": {\"city\": \"Riyadh\"},\n  \"nickname\": null\n}",
     "highlight": [
      5,
      7,
      8,
      9
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "🗂️",
       "color": "blue",
       "title": {
        "en": "`{...}` → `dict`",
        "ar": "`{...}` ← `dict`"
       },
       "text": {
        "en": "object",
        "ar": "الـ object"
       }
      },
      {
       "icon": "📚",
       "color": "green",
       "title": {
        "en": "`[...]` → `list`",
        "ar": "`[...]` ← `list`"
       },
       "text": {
        "en": "array",
        "ar": "الـ array"
       }
      },
      {
       "icon": "🔤",
       "color": "yellow",
       "title": {
        "en": "`\"text\"` → `str`",
        "ar": "`\"text\"` ← `str`"
       },
       "text": {
        "en": "string",
        "ar": "الـ string"
       }
      },
      {
       "icon": "🔢",
       "color": "purple",
       "title": {
        "en": "number → `int` / `float`",
        "ar": "رقم ← `int` / `float`"
       },
       "text": {
        "en": "number",
        "ar": "الأرقام"
       }
      },
      {
       "icon": "✅",
       "color": "cyan",
       "title": {
        "en": "`true` → `True`",
        "ar": "`true` ← `True`"
       },
       "text": {
        "en": "`false` → `False`",
        "ar": "`false` ← `False`"
       }
      },
      {
       "icon": "🕳️",
       "color": "red",
       "title": {
        "en": "`null` → `None`",
        "ar": "`null` ← `None`"
       },
       "text": {
        "en": "no value",
        "ar": "بلا قيمة"
       }
      }
     ]
    },
    {
     "type": "compare",
     "left": {
      "title": {
       "en": "Valid JSON",
       "ar": "JSON صالح"
      },
      "tone": "good",
      "items": [
       {
        "en": "`{\"name\": \"Sara\", \"age\": 25}`",
        "ar": "`{\"name\": \"Sara\", \"age\": 25}`"
       },
       {
        "en": "Double quotes for keys, strings",
        "ar": "تنصيص مزدوج للمفاتيح والنصوص"
       },
       {
        "en": "No comma after last item",
        "ar": "لا فاصلة بعد آخر عنصر"
       }
      ]
     },
     "right": {
      "title": {
       "en": "Invalid JSON",
       "ar": "JSON غير صالح"
      },
      "tone": "bad",
      "items": [
       {
        "en": "`{'name': 'Sara', 'age': 25,}`",
        "ar": "`{'name': 'Sara', 'age': 25,}`"
       },
       {
        "en": "Single quotes",
        "ar": "تنصيص مفرد"
       },
       {
        "en": "Trailing comma",
        "ar": "فاصلة زائدة في النهاية"
       },
       {
        "en": "Comments like `// note`",
        "ar": "تعليقات مثل `// note`"
       }
      ]
     }
    },
    {
     "type": "code",
     "lang": "python",
     "code": "import json\n\ndata = json.loads('{\"name\": \"Sara\", \"active\": true}')\nprint(data)  # {'name': 'Sara', 'active': True}\n\ntext = json.dumps({\"nickname\": None})\nprint(text)  # {\"nickname\": null}",
     "highlight": [
      3,
      6
     ]
    },
    {
     "type": "tip",
     "en": "JSON bodies are sent with the header `Content-Type: application/json`, both ways.",
     "ar": "الـ body بصيغة JSON يُرسل مع الـ header `Content-Type: application/json` في الاتجاهين."
    }
   ]
  },
  {
   "id": "fastapi-teaser",
   "title": {
    "en": "A first look at FastAPI",
    "ar": "نظرة أولى على FastAPI"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "⚡",
     "en": "FastAPI turns Python functions into endpoints",
     "ar": "الـ FastAPI يحوّل دوال Python إلى endpoints"
    },
    {
     "type": "code",
     "lang": "python",
     "code": "from fastapi import FastAPI\n\napp = FastAPI()\n\n@app.get(\"/users/{user_id}\")\ndef get_user(user_id: int):\n    return {\"id\": user_id, \"name\": \"Sara\"}",
     "highlight": [
      5,
      6,
      7
     ]
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "@app"
      },
