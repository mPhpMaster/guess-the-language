{
 "id": "parameters",
 "icon": "🧭",
 "title": {
  "en": "Path and query parameters",
  "ar": "معاملات المسار والاستعلام"
 },
 "summary": {
  "en": "Read values from the URL path and query string, convert their types, and validate them with Query and Path.",
  "ar": "اقرأ القيم من مسار الرابط ومن الاستعلام، وحوّل أنواعها، وتحقق منها باستخدام Query وPath."
 },
 "lessons": [
  {
   "id": "path-parameters",
   "title": {
    "en": "Path parameters",
    "ar": "معاملات المسار (path parameters)"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🧩",
     "en": "URL pieces become function arguments",
     "ar": "أجزاء الرابط تصبح وسائط (arguments) للدالة"
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "GET",
       "color": "blue",
       "label": {
        "en": "method",
        "ar": "الطريقة (method)"
       }
      },
      {
       "text": " /items/"
      },
      {
       "text": "5",
       "color": "green",
       "label": {
        "en": "path value → `item_id`",
        "ar": "قيمة المسار ← `item_id`"
       }
      }
     ]
    },
    {
     "type": "code",
     "lang": "python",
     "code": "from fastapi import FastAPI\n\napp = FastAPI()\n\n@app.get(\"/items/{item_id}\")\ndef read_item(item_id: int):\n    return {\"item_id\": item_id}",
     "highlight": [
      5,
      6
     ]
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "GET /items/5",
       "note": {
        "en": "text in the URL",
        "ar": "نصّ داخل الرابط"
       }
      },
      {
       "from": "server",
       "text": "200 OK  {\"item_id\": 5}",
       "note": {
        "en": "converted to the number 5",
        "ar": "حُوِّل إلى الرقم 5"
       }
      },
      {
       "from": "client",
       "text": "GET /items/abc",
       "note": {
        "en": "not a number",
        "ar": "ليس رقمًا"
       }
      },
      {
       "from": "server",
       "text": "422  {\"detail\": [{\"type\": \"int_parsing\",\n  \"loc\": [\"path\", \"item_id\"], \"input\": \"abc\"}]}",
       "note": {
        "en": "your function never runs",
        "ar": "دالتك لا تُنفَّذ أصلًا"
       }
      }
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "📋",
       "color": "blue",
       "title": {
        "en": "`detail`",
        "ar": "`detail`"
       },
       "text": {
        "en": "A list: one entry per problem",
        "ar": "قائمة: عنصر واحد لكل مشكلة"
       }
      },
      {
       "icon": "🏷️",
       "color": "purple",
       "title": {
        "en": "`type`",
        "ar": "`type`"
       },
       "text": {
        "en": "Short error code, like `int_parsing`",
        "ar": "رمز قصير للخطأ مثل `int_parsing`"
       }
      },
      {
       "icon": "📍",
       "color": "green",
       "title": {
        "en": "`loc`",
        "ar": "`loc`"
       },
       "text": {
        "en": "Where: `path`, then the parameter name",
        "ar": "المكان: `path` ثم اسم المعامل"
       }
      },
      {
       "icon": "💬",
       "color": "yellow",
       "title": {
        "en": "`msg` + `input`",
        "ar": "`msg` + `input`"
       },
       "text": {
        "en": "Readable message, and the value sent",
        "ar": "رسالة مقروءة، والقيمة المُرسَلة"
       }
      }
     ]
    },
    {
     "type": "tip",
     "en": "No type hint, no conversion: `/items/5` returns `{\"item_id\": \"5\"}` as a string.",
     "ar": "بدون تلميح نوع لا يحدث تحويل: `/items/5` يعيد `{\"item_id\": \"5\"}` كنص."
    }
   ]
  },
  {
   "id": "route-order-and-enums",
   "title": {
    "en": "Route order and Enum parameters",
    "ar": "ترتيب المسارات ومعاملات Enum"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🚦",
     "en": "Top to bottom: the first match wins",
     "ar": "من الأعلى للأسفل: أول مسار مطابق يفوز"
    },
    {
     "type": "compare",
     "left": {
      "title": {
       "en": "Fixed path first",
       "ar": "المسار الثابت أولًا"
      },
      "tone": "good",
      "items": [
       {
        "en": "`/users/me`, then `/users/{user_id}`",
        "ar": "`/users/me` ثم `/users/{user_id}`"
       },
       {
        "en": "`/users/me` → `{\"user\": \"current user\"}`",
        "ar": "`/users/me` ← `{\"user\": \"current user\"}`"
       },
       {
        "en": "`/users/42` → `{\"user_id\": \"42\"}`",
        "ar": "`/users/42` ← `{\"user_id\": \"42\"}`"
       }
      ]
     },
     "right": {
      "title": {
       "en": "Pattern first",
       "ar": "النمط أولًا"
      },
      "tone": "bad",
      "items": [
       {
        "en": "`/users/{user_id}` also matches `/users/me`",
        "ar": "`/users/{user_id}` يطابق `/users/me` أيضًا"
       },
       {
        "en": "`/users/me` → `{\"user_id\": \"me\"}`",
        "ar": "`/users/me` ← `{\"user_id\": \"me\"}`"
       },
       {
        "en": "With `user_id: int`: `422`",
        "ar": "مع `user_id: int`: النتيجة `422`"
       }
      ]
     }
    },
    {
     "type": "code",
     "lang": "python",
     "code": "@app.get(\"/users/me\")          # fixed path first\ndef read_me():\n    return {\"user\": \"current user\"}\n\n@app.get(\"/users/{user_id}\")   # pattern second\ndef read_user(user_id: str):\n    return {\"user_id\": user_id}",
     "highlight": [
      1,
      5
     ]
    },
    {
     "type": "code",
     "lang": "python",
     "code": "from enum import Enum\n\nclass ModelName(str, Enum):\n    alexnet = \"alexnet\"\n    resnet = \"resnet\"\n    lenet = \"lenet\"\n\n@app.get(\"/models/{model_name}\")\ndef get_model(model_name: ModelName):\n    return {\"model_name\": model_name, \"value\": model_name.value}",
     "highlight": [
      3,
      9
     ]
    },
    {
     "type": "pills",
     "items": [
      {
       "text": "alexnet",
       "color": "green",
       "label": {
        "en": "allowed",
        "ar": "مسموح"
       }
      },
      {
       "text": "resnet",
       "color": "green",
       "label": {
        "en": "allowed",
        "ar": "مسموح"
       }
      },
      {
       "text": "lenet",
       "color": "green",
       "label": {
        "en": "allowed",
        "ar": "مسموح"
       }
      },
      {
       "text": "AlexNet",
       "color": "red",
       "label": {
        "en": "422: capitals",
        "ar": "422: أحرف كبيرة"
       }
      },
      {
       "text": "vgg",
       "color": "red",
       "label": {
        "en": "422: not listed",
        "ar": "422: غير مُدرَج"
       }
      }
     ]
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "GET /models/lenet"
      },
      {
       "from": "server",
       "text": "200 OK  {\"model_name\": \"lenet\", \"value\": \"lenet\"}"
      },
      {
       "from": "client",
       "text": "GET /models/AlexNet"
      },
      {
       "from": "server",
       "text": "422  \"Input should be 'alexnet', 'resnet' or 'lenet'\"",
       "note": {
        "en": "only the listed values",
        "ar": "القيم المُدرَجة فقط"
       }
      }
     ]
    },
    {
     "type": "tip",
     "en": "A `str` + `Enum` class limits the values, and `/docs` lists them.",
     "ar": "صنف (class) يرث من `str` و`Enum` يحدّد القيم المسموحة، و`/docs` يعرضها."
    }
   ]
  },
  {
   "id": "query-parameters",
   "title": {
    "en": "Query parameters",
    "ar": "معاملات الاستعلام (query parameters)"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "❓",
     "en": "After the ? come query parameters",
     "ar": "بعد علامة ? تأتي معاملات الاستعلام"
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "GET",
       "color": "blue",
       "label": {
        "en": "method",
        "ar": "الطريقة (method)"
       }
      },
      {
       "text": " /items/",
       "color": "green",
       "label": {
        "en": "path",
        "ar": "المسار (path)"
       }
      },
      {
       "text": "?",
       "color": "red",
       "label": {
        "en": "query starts here",
        "ar": "هنا يبدأ الاستعلام"
       }
      },
      {
       "text": "skip=1",
       "color": "yellow",
       "label": {
        "en": "`key=value` → `skip`",
        "ar": "`key=value` ← `skip`"
       }
      },
      {
       "text": "&",
       "color": "purple",
       "label": {
        "en": "joins the pairs",
        "ar": "يفصل بين الأزواج"
       }
      },
      {
       "text": "limit=1",
       "color": "cyan",
       "label": {
        "en": "`key=value` → `limit`",
        "ar": "`key=value` ← `limit`"
       }
      }
     ]
    },
    {
     "type": "code",
     "lang": "python",
     "code": "fake_items = [{\"name\": \"a\"}, {\"name\": \"b\"}, {\"name\": \"c\"}]\n\n@app.get(\"/items/\")\ndef list_items(skip: int = 0, limit: int = 10):\n    return fake_items[skip : skip + limit]",
     "highlight": [
      4
     ]
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "GET /items/?skip=1&limit=1"
      },
      {
       "from": "server",
       "text": "200  [{\"name\": \"b\"}]"
      },
      {
       "from": "client",
       "text": "GET /items/",
       "note": {
        "en": "no query at all",
        "ar": "بدون استعلام"
       }
      },
      {
       "from": "server",
       "text": "200  [{\"name\": \"a\"}, {\"name\": \"b\"}, {\"name\": \"c\"}]",
       "note": {
        "en": "defaults used",
        "ar": "استُخدمت القيم الافتراضية"
       }
      },
      {
       "from": "client",
       "text": "GET /items/?limit=x"
      },
      {
       "from": "server",
       "text": "422  loc: [\"query\", \"limit\"]"
      }
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "🟢",
       "color": "green",
       "title": {
        "en": "`skip: int = 0`",
        "ar": "`skip: int = 0`"
       },
       "text": {
        "en": "Optional: default used when missing",
        "ar": "اختياري: تُستخدم القيمة الافتراضية عند غيابه"
       }
      },
      {
       "icon": "🔵",
       "color": "blue",
       "title": {
        "en": "`q: str | None = None`",
        "ar": "`q: str | None = None`"
       },
       "text": {
        "en": "Optional: `q` is `None` when missing",
        "ar": "اختياري: `q` تساوي `None` عند غيابه"
       }
      },
      {
       "icon": "🔴",
       "color": "red",
       "title": {
        "en": "`name: str`",
        "ar": "`name: str`"
       },
       "text": {
        "en": "Required: missing gives `422`, type `missing`",
        "ar": "إلزامي: غيابه يعطي `422` بالنوع `missing`"
       }
      }
     ]
    },
    {
     "type": "pills",
     "items": [
      {
       "text": "1",
       "color": "green",
       "label": {
        "en": "True",
        "ar": "True"
       }
      },
      {
       "text": "true / True",
       "color": "green",
       "label": {
        "en": "True",
        "ar": "True"
       }
      },
      {
       "text": "yes",
       "color": "green",
       "label": {
        "en": "True",
        "ar": "True"
       }
      },
      {
       "text": "on",
       "color": "green",
       "label": {
        "en": "True",
        "ar": "True"
       }
      },
      {
       "text": "0",
       "color": "red",
       "label": {
        "en": "False",
        "ar": "False"
       }
      },
      {
       "text": "false",
       "color": "red",
       "label": {
        "en": "False",
        "ar": "False"
       }
      },
      {
       "text": "no",
       "color": "red",
       "label": {
        "en": "False",
        "ar": "False"
       }
      },
      {
       "text": "off",
       "color": "red",
       "label": {
        "en": "False",
        "ar": "False"
       }
      }
     ]
    },
    {
     "type": "warn",
     "en": "With `short: bool = False`, anything else, like `?short=maybe`, gives `422` `bool_parsing`.",
     "ar": "مع `short: bool = False`، أي قيمة أخرى مثل `?short=maybe` تعطي `422` بالنوع `bool_parsing`."
    },
    {
     "type": "tip",
     "en": "Undeclared query parameters are ignored: a typo like `?lenght=5` raises no error.",
     "ar": "معاملات الاستعلام غير المعرّفة تُتجاهَل: خطأ إملائي مثل `?lenght=5` لا يسبّب أي خطأ."
    }
   ]
  },
  {
   "id": "validation-with-annotated",
   "title": {
    "en": "Validation with Annotated, Query and Path",
    "ar": "التحقق باستخدام Annotated وQuery وPath"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🛡️",
     "en": "Annotated adds rules to a type",
     "ar": "Annotated يضيف قواعد إلى النوع"
    },
    {
     "type": "code",
     "lang": "python",
     "code": "from typing import Annotated\nfrom fastapi import FastAPI, Path, Query\n\napp = FastAPI()\n\n@app.get(\"/search\")\ndef search(q: Annotated[str | None, Query(min_length=3, max_length=10)] = None):\n    return {\"q\": q}\n\n@app.get(\"/items/{item_id}\")\ndef read_item(item_id: Annotated[int, Path(ge=1, le=1000)]):\n    return {\"item_id\": item_id}",
     "highlight": [
      7,
      11
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "📏",
       "color": "blue",
       "title": {
        "en": "`min_length` / `max_length`",
        "ar": "`min_length` / `max_length`"
       },
       "text": {
        "en": "Length limits for strings",
        "ar": "حدود الطول للنصوص"
       }
      },
      {
       "icon": "⚖️",
       "color": "green",
       "title": {
        "en": "`ge` / `le`",
        "ar": "`ge` / `le`"
       },
       "text": {
        "en": "Greater-or-equal / less-or-equal for numbers",
        "ar": "أكبر من أو يساوي / أصغر من أو يساوي للأرقام"
       }
      },
      {
       "icon": "🎯",
       "color": "yellow",
       "title": {
        "en": "`gt` / `lt`",
        "ar": "`gt` / `lt`"
       },
       "text": {
        "en": "Strictly greater / strictly less",
        "ar": "أكبر تمامًا / أصغر تمامًا"
       }
      },
      {
       "icon": "🔤",
       "color": "purple",
       "title": {
        "en": "`pattern`",
        "ar": "`pattern`"
       },
       "text": {
        "en": "String must match a regular expression",
        "ar": "يجب أن يطابق النص تعبيرًا نمطيًا (regex)"
       }
      }
     ]
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "GET /search?q=ab"
      },
      {
       "from": "server",
       "text": "422  \"String should have at least 3 characters\""
      },
      {
       "from": "client",
       "text": "GET /search?q=abc"
      },
      {
       "from": "server",
       "text": "200  {\"q\": \"abc\"}"
      },
      {
       "from": "client",
       "text": "GET /search",
       "note": {
        "en": "no `q` sent",
        "ar": "لم يُرسَل `q`"
       }
      },
      {
       "from": "server",
       "text": "200  {\"q\": null}",
       "note": {
        "en": "rules apply only when sent",
        "ar": "القواعد تُطبَّق عند الإرسال فقط"
       }
      },
      {
       "from": "client",
       "text": "GET /items/0"
      },
      {
       "from": "server",
       "text": "422  \"Input should be greater than or equal to 1\""
      }
     ]
    },
    {
     "type": "code",
     "lang": "python",
     "code": "@app.get(\"/rates\")\ndef rates(code: Annotated[str, Query(pattern=\"^[A-Z]{3}$\")]):\n    return {\"code\": code}",
     "highlight": [
      2
     ]
    },
    {
     "type": "pills",
     "items": [
      {
       "text": "?code=USD",
       "color": "green",
       "label": {
        "en": "200",
        "ar": "200"
       }
      },
      {
       "text": "?code=usd",
       "color": "red",
       "label": {
        "en": "422: lowercase",
        "ar": "422: أحرف صغيرة"
       }
      },
      {
       "text": "?code=USDT",
       "color": "red",
       "label": {
        "en": "422: four letters",
        "ar": "422: أربعة أحرف"
       }
      },
      {
       "text": "(no code)",
       "color": "yellow",
       "label": {
        "en": "422: required",
        "ar": "422: إلزامي"
       }
      }
     ]
    },
    {
     "type": "tip",
     "en": "A failed `pattern` gives `422` with type `string_pattern_mismatch`.",
     "ar": "فشل `pattern` يعطي `422` بالنوع `string_pattern_mismatch`."
    }
   ]
  },
  {
   "id": "path-and-query-together",
   "title": {
    "en": "Path and query together",
    "ar": "المسار والاستعلام معًا"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🔗",
     "en": "In the path? Path param. Otherwise: query",
     "ar": "في المسار؟ معامل مسار. وإلا: استعلام"
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "/users/"
      },
      {
       "text": "7",
       "color": "green",
       "label": {
        "en": "`user_id = 7` · path",
        "ar": "`user_id = 7` · مسار"
       }
      },
      {
       "text": "/items/"
      },
      {
       "text": "pen",
       "color": "cyan",
       "label": {
        "en": "`item_id = \"pen\"` · path",
        "ar": "`item_id = \"pen\"` · مسار"
       }
      },
      {
       "text": "?"
      },
      {
       "text": "q=blue",
       "color": "yellow",
       "label": {
        "en": "`q = \"blue\"` · query",
        "ar": "`q = \"blue\"` · استعلام"
       }
      },
      {
       "text": "&"
      },
      {
       "text": "short=true",
       "color": "purple",
       "label": {
        "en": "`short = True` · query",
        "ar": "`short = True` · استعلام"
       }
      }
     ]
    },
    {
     "type": "code",
     "lang": "python",
     "code": "@app.get(\"/users/{user_id}/items/{item_id}\")\ndef read_user_item(user_id: int, item_id: str,\n                   q: str | None = None, short: bool = False):\n    item = {\"item_id\": item_id, \"owner_id\": user_id}\n    if q:\n        item[\"q\"] = q\n    if not short:\n        item[\"description\"] = \"A long description\"\n    return item",
     "highlight": [
      1,
      2,
      3
     ]
    },
    {
     "type": "flow",
     "nodes": [
      {
       "icon": "🌐",
       "label": {
        "en": "The URL",
        "ar": "الرابط"
       }
      },
      {
       "icon": "⚡",
       "label": {
        "en": "FastAPI matches names",
        "ar": "FastAPI يطابق الأسماء"
       }
      },
      {
       "icon": "🐍",
       "label": {
        "en": "Typed function arguments",
        "ar": "وسائط الدالة بأنواعها"
       }
      }
     ],
     "links": [
      {
       "label": {
        "en": "path + query",
        "ar": "مسار + استعلام"
       }
      },
      {
       "label": {
        "en": "converted values",
        "ar": "قيم محوَّلة"
       }
      }
     ]
    },
    {
     "type": "chat",
