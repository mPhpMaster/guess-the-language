{
 "id": "internet-and-links",
 "icon": "🌍",
 "title": {
  "en": "The internet and links",
  "ar": "الإنترنت والروابط"
 },
 "summary": {
  "en": "How computers find each other online, and what every part of a link means.",
  "ar": "كيف تجد الحواسيب بعضها على الإنترنت، وماذا يعني كل جزء من الرابط."
 },
 "lessons": [
  {
   "id": "what-is-the-internet",
   "title": {
    "en": "The internet: clients and servers",
    "ar": "الإنترنت: العملاء والخوادم"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🌍",
     "en": "The internet is computers talking to each other",
     "ar": "الإنترنت حواسيب يتحدث بعضها مع بعض"
    },
    {
     "type": "flow",
     "nodes": [
      {
       "icon": "📱",
       "label": {
        "en": "Your phone",
        "ar": "هاتفك"
       }
      },
      {
       "icon": "📡",
       "label": {
        "en": "Router and cables",
        "ar": "الراوتر والكابلات"
       }
      },
      {
       "icon": "🖥️",
       "label": {
        "en": "A computer far away",
        "ar": "حاسوب بعيد"
       }
      }
     ],
     "links": [
      {
       "label": {
        "en": "Wi-Fi",
        "ar": "الـ Wi-Fi"
       }
      },
      {
       "label": {
        "en": "cables, even undersea",
        "ar": "كابلات، حتى تحت البحر"
       }
      }
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "🧑",
       "color": "blue",
       "title": {
        "en": "Customer = client",
        "ar": "الزبون = العميل (client)"
       },
       "text": {
        "en": "Your browser or app; it asks for things",
        "ar": "متصفحك أو تطبيقك؛ هو الذي يطلب"
       }
      },
      {
       "icon": "🧾",
       "color": "yellow",
       "title": {
        "en": "Order = request",
        "ar": "الطلب = request"
       },
       "text": {
        "en": "\"Give me this page, please\"",
        "ar": "«أعطني هذه الصفحة من فضلك»"
       }
      },
      {
       "icon": "👨‍🍳",
       "color": "green",
       "title": {
        "en": "Kitchen = server",
        "ar": "المطبخ = الخادم (server)"
       },
       "text": {
        "en": "Prepares what you asked for and sends it",
        "ar": "يجهّز ما طلبته ويرسله إليك"
       }
      },
      {
       "icon": "🍽️",
       "color": "purple",
       "title": {
        "en": "Dish = response",
        "ar": "الطبق = الاستجابة (response)"
       },
       "text": {
        "en": "The page, photo or data you receive",
        "ar": "الصفحة أو الصورة أو البيانات التي تصلك"
       }
      }
     ]
    },
    {
     "type": "flow",
     "nodes": [
      {
       "icon": "💻",
       "label": {
        "en": "Client (browser)",
        "ar": "العميل (المتصفح)"
       }
      },
      {
       "icon": "🖥️",
       "label": {
        "en": "Server",
        "ar": "الخادم"
       }
      }
     ],
     "links": [
      {
       "label": {
        "en": "request",
        "ar": "طلب (request)"
       }
      }
     ],
     "returns": {
      "en": "response",
      "ar": "استجابة (response)"
     }
    },
    {
     "type": "pills",
     "items": [
      {
       "text": "google.com",
       "color": "blue",
       "label": {
        "en": "search server",
        "ar": "خادم بحث"
       }
      },
      {
       "text": "youtube.com",
       "color": "red",
       "label": {
        "en": "video server",
        "ar": "خادم فيديو"
       }
      },
      {
       "text": "wikipedia.org",
       "color": "green",
       "label": {
        "en": "article server",
        "ar": "خادم مقالات"
       }
      },
      {
       "text": "your-app",
       "color": "purple",
       "label": {
        "en": "soon: yours!",
        "ar": "قريبًا: خادمك أنت!"
       }
      }
     ]
    },
    {
     "type": "tip",
     "en": "A server is just a computer that is always on, waiting for requests.",
     "ar": "الخادم (server) مجرد حاسوب يعمل دائمًا وينتظر الطلبات."
    }
   ]
  },
  {
   "id": "ip-addresses-and-dns",
   "title": {
    "en": "IP addresses and DNS",
    "ar": "عناوين IP ونظام DNS"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "📞",
     "en": "Every computer online has a number, like a phone",
     "ar": "لكل حاسوب على الإنترنت رقم، مثل رقم الهاتف"
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "104",
       "color": "blue",
       "label": {
        "en": "0 to 255",
        "ar": "من 0 إلى 255"
       }
      },
      {
       "text": "."
      },
      {
       "text": "20",
       "color": "green",
       "label": {
        "en": "0 to 255",
        "ar": "من 0 إلى 255"
       }
      },
      {
       "text": "."
      },
      {
       "text": "23",
       "color": "yellow",
       "label": {
        "en": "0 to 255",
        "ar": "من 0 إلى 255"
       }
      },
      {
       "text": "."
      },
      {
       "text": "154",
       "color": "purple",
       "label": {
        "en": "0 to 255",
        "ar": "من 0 إلى 255"
       }
      }
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "🔢",
       "color": "blue",
       "title": {
        "en": "IP address",
        "ar": "عنوان IP (IP address)"
       },
       "text": {
        "en": "The computer's number, e.g. `104.20.23.154`",
        "ar": "رقم الحاسوب، مثل `104.20.23.154`"
       }
      },
      {
       "icon": "4️⃣",
       "color": "green",
       "title": {
        "en": "IPv4",
        "ar": "الـ IPv4"
       },
       "text": {
        "en": "Four numbers from 0 to 255, joined by dots",
        "ar": "أربعة أرقام من 0 إلى 255 بينها نقاط"
       }
      },
      {
       "icon": "📒",
       "color": "yellow",
       "title": {
        "en": "DNS = contacts app",
        "ar": "الـ DNS = تطبيق جهات الاتصال"
       },
       "text": {
        "en": "You type a name, it finds the number",
        "ar": "تكتب الاسم، فيجد لك الرقم"
       }
      }
     ]
    },
    {
     "type": "chat",
     "messages": [
      {
       "from": "client",
       "text": "example.com ?",
       "note": {
        "en": "what is its number?",
        "ar": "ما رقمه؟"
       }
      },
      {
       "from": "server",
       "text": "104.20.23.154",
       "note": {
        "en": "DNS answers with the IP",
        "ar": "الـ DNS يجيب بعنوان IP"
       }
      }
     ]
    },
    {
     "type": "code",
     "lang": "text",
     "code": "> nslookup example.com\nName:    example.com\nAddresses:  172.66.147.243\n            104.20.23.154",
     "highlight": [
      1,
      3,
      4
     ]
    },
    {
     "type": "tip",
     "en": "`nslookup` asks DNS yourself. Big sites have several IPs, and they can change.",
     "ar": "الأمر `nslookup` يسأل الـ DNS بنفسك. للمواقع الكبيرة عدة عناوين IP، وقد تتغيّر."
    }
   ]
  },
  {
   "id": "url-scheme-domain-port",
   "title": {
    "en": "A link, part 1: scheme, domain, port",
    "ar": "الرابط، الجزء 1: البروتوكول والنطاق والمنفذ"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🔗",
     "en": "A link (URL) is a full address",
     "ar": "الرابط (URL) عنوان كامل"
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "https",
       "color": "purple",
       "label": {
        "en": "scheme (protocol)",
        "ar": "الـ scheme (البروتوكول)"
       }
      },
      {
       "text": "://"
      },
      {
       "text": "shop.example.com",
       "color": "blue",
       "label": {
        "en": "domain",
        "ar": "النطاق (domain)"
       }
      },
      {
       "text": ":443",
       "color": "cyan",
       "label": {
        "en": "port",
        "ar": "المنفذ (port)"
       }
      },
      {
       "text": "/products/42",
       "color": "green",
       "label": {
        "en": "path",
        "ar": "المسار (path)"
       }
      },
      {
       "text": "?color=red",
       "color": "yellow",
       "label": {
        "en": "query string",
        "ar": "الـ query string"
       }
      },
      {
       "text": "#reviews",
       "color": "red",
       "label": {
        "en": "fragment",
        "ar": "الـ fragment"
       }
      }
     ]
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "shop",
       "color": "green",
       "label": {
        "en": "subdomain",
        "ar": "النطاق الفرعي (subdomain)"
       }
      },
      {
       "text": "."
      },
      {
       "text": "example",
       "color": "blue",
       "label": {
        "en": "domain name",
        "ar": "اسم النطاق (domain name)"
       }
      },
      {
       "text": "."
      },
      {
       "text": "com",
       "color": "yellow",
       "label": {
        "en": "TLD (top-level domain)",
        "ar": "الـ TLD (النطاق العلوي)"
       }
      }
     ]
    },
    {
     "type": "pills",
     "items": [
      {
       "text": ".com",
       "color": "blue",
       "label": {
        "en": "commercial",
        "ar": "تجاري"
       }
      },
      {
       "text": ".org",
       "color": "green",
       "label": {
        "en": "organisations",
        "ar": "منظمات"
       }
      },
      {
       "text": ".sa",
       "color": "purple",
       "label": {
        "en": "Saudi Arabia",
        "ar": "السعودية"
       }
      },
      {
       "text": ".edu",
       "color": "yellow",
       "label": {
        "en": "education",
        "ar": "تعليم"
       }
      }
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "🗣️",
       "color": "purple",
       "title": {
        "en": "Scheme",
        "ar": "الـ scheme"
       },
       "text": {
        "en": "The shared language: `https` is secure, `http` is not",
        "ar": "اللغة المشتركة: `https` آمن، و`http` غير آمن"
       }
      },
      {
       "icon": "🏢",
       "color": "blue",
       "title": {
        "en": "Domain",
        "ar": "النطاق (domain)"
       },
       "text": {
        "en": "Which server; DNS turns it into an IP",
        "ar": "أي خادم؛ والـ DNS يحوّله إلى IP"
       }
      },
      {
       "icon": "🚪",
       "color": "cyan",
       "title": {
        "en": "Port",
        "ar": "المنفذ (port)"
       },
       "text": {
        "en": "Which door on that server; usually hidden",
        "ar": "أي باب في ذلك الخادم؛ غالبًا مخفي"
       }
      }
     ]
    },
    {
     "type": "compare",
     "left": {
      "title": {
       "en": "https (default port)",
       "ar": "https (المنفذ الافتراضي)"
      },
      "tone": "neutral",
      "items": [
       {
        "en": "Hidden port is `443`",
        "ar": "المنفذ المخفي هو `443`"
       },
       {
        "en": "`example.com` = `example.com:443`",
        "ar": "`example.com` = `example.com:443`"
       }
      ]
     },
     "right": {
      "title": {
       "en": "http (default port)",
       "ar": "http (المنفذ الافتراضي)"
      },
      "tone": "neutral",
      "items": [
       {
        "en": "Hidden port is `80`",
        "ar": "المنفذ المخفي هو `80`"
       },
       {
        "en": "Other ports must be written: `:8000`",
        "ar": "غير ذلك يجب كتابته: `:8000`"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "url-path-query-fragment",
   "title": {
    "en": "A link, part 2: path, query, fragment",
    "ar": "الرابط، الجزء 2: المسار والاستعلام والجزء"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "🗺️",
     "en": "After the domain: where, which, and jump-to",
     "ar": "بعد النطاق: أين، وأيّ، وإلى أين تقفز"
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "https://www.example.com"
      },
      {
       "text": "/search",
       "color": "green",
       "label": {
        "en": "path: which page",
        "ar": "المسار: أي صفحة"
       }
      },
      {
       "text": "?",
       "color": "yellow",
       "label": {
        "en": "query starts here",
        "ar": "بداية الـ query"
       }
      },
      {
       "text": "q=cats",
       "color": "yellow",
       "label": {
        "en": "key=value",
        "ar": "مفتاح=قيمة"
       }
      },
      {
       "text": "&",
       "color": "cyan",
       "label": {
        "en": "joins pairs",
        "ar": "يربط الأزواج"
       }
      },
      {
       "text": "page=2",
       "color": "yellow",
       "label": {
        "en": "key=value",
        "ar": "مفتاح=قيمة"
       }
      }
     ]
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "https://en.wikipedia.org"
      },
      {
       "text": "/wiki/Internet",
       "color": "green",
       "label": {
        "en": "path",
        "ar": "المسار (path)"
       }
      },
      {
       "text": "#History",
       "color": "red",
       "label": {
        "en": "fragment: jump to section",
        "ar": "الـ fragment: قفزة إلى قسم"
       }
      }
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "📂",
       "color": "green",
       "title": {
        "en": "Path `/a/b`",
        "ar": "المسار `/a/b`"
       },
       "text": {
        "en": "Like folders: which page on the server",
        "ar": "مثل المجلدات: أي صفحة في الخادم"
       }
      },
      {
       "icon": "🎛️",
       "color": "yellow",
       "title": {
        "en": "Query `?k=v&k2=v2`",
        "ar": "الـ query `?k=v&k2=v2`"
       },
       "text": {
        "en": "Extra choices: search words, page number, colour",
        "ar": "خيارات إضافية: كلمات البحث، رقم الصفحة، اللون"
       }
      },
      {
       "icon": "🔖",
       "color": "red",
       "title": {
        "en": "Fragment `#name`",
        "ar": "الـ fragment `#name`"
       },
       "text": {
        "en": "Bookmark inside the page; stays in your browser",
        "ar": "علامة داخل الصفحة؛ تبقى في متصفحك"
       }
      }
     ]
    },
    {
     "type": "anatomy",
     "parts": [
      {
       "text": "http",
       "color": "purple",
       "label": {
        "en": "scheme",
        "ar": "الـ scheme"
       }
      },
      {
       "text": "://"
      },
      {
       "text": "127.0.0.1",
       "color": "blue",
       "label": {
        "en": "IP instead of name",
        "ar": "IP بدل الاسم"
       }
      },
      {
       "text": ":8000",
       "color": "cyan",
       "label": {
        "en": "port, written out",
        "ar": "منفذ مكتوب صراحة"
       }
      },
      {
       "text": "/items/5",
       "color": "green",
       "label": {
        "en": "path",
        "ar": "المسار (path)"
       }
      },
      {
       "text": "?q=book",
       "color": "yellow",
       "label": {
        "en": "query string",
        "ar": "الـ query string"
       }
      }
     ]
    },
    {
     "type": "warn",
     "en": "The `#fragment` is never sent to the server. Only your browser uses it.",
     "ar": "الـ `#fragment` لا يُرسل إلى الخادم أبدًا. متصفحك وحده يستخدمه."
    }
   ]
  },
  {
   "id": "press-enter-and-localhost",
   "title": {
    "en": "Press Enter, and localhost",
    "ar": "اضغط Enter، والـ localhost"
   },
   "blocks": [
    {
     "type": "hero",
     "emoji": "⏎",
     "en": "One key press, five quick steps",
     "ar": "ضغطة زر واحدة، وخمس خطوات سريعة"
    },
    {
     "type": "steps",
     "items": [
      {
       "en": "You type the URL, press Enter",
       "ar": "تكتب الرابط (URL) وتضغط Enter"
      },
      {
       "en": "DNS turns the domain into IP",
       "ar": "الـ DNS يحوّل النطاق إلى IP"
      },
      {
       "en": "Browser connects to that IP and port",
       "ar": "المتصفح يتصل بذلك الـ IP والمنفذ"
      },
      {
       "en": "Browser sends a request: `GET /products/42`",
       "ar": "المتصفح يرسل طلبًا: `GET /products/42`"
      },
      {
       "en": "Server replies; browser draws the page",
       "ar": "الخادم يرد؛ والمتصفح يرسم الصفحة"
      }
     ]
    },
    {
     "type": "flow",
     "nodes": [
      {
       "icon": "⌨️",
       "label": {
        "en": "You",
        "ar": "أنت"
       }
      },
      {
       "icon": "📒",
       "label": {
        "en": "DNS",
        "ar": "الـ DNS"
       }
      },
      {
       "icon": "🖥️",
       "label": {
        "en": "Server",
        "ar": "الخادم"
       }
      },
      {
       "icon": "🖼️",
       "label": {
        "en": "Page on screen",
        "ar": "الصفحة على الشاشة"
       }
      }
     ],
     "links": [
      {
       "label": {
        "en": "name?",
        "ar": "ما الرقم؟"
       }
      },
      {
       "label": {
        "en": "connect + request",
        "ar": "اتصال + طلب"
       }
      },
      {
       "label": {
        "en": "response",
        "ar": "استجابة (response)"
       }
      }
     ]
    },
    {
     "type": "cards",
     "items": [
      {
       "icon": "🏠",
       "color": "green",
       "title": {
        "en": "`localhost`",
        "ar": "`localhost`"
       },
       "text": {
        "en": "A special name meaning \"this very computer\"",
        "ar": "اسم خاص معناه «هذا الحاسوب نفسه»"
       }
      },
      {
       "icon": "🔁",
       "color": "blue",
       "title": {
        "en": "`127.0.0.1`",
        "ar": "`127.0.0.1`"
       },
       "text": {
        "en": "The IP of localhost; it never leaves your PC",
        "ar": "عنوان IP للـ localhost؛ لا يغادر جهازك"
       }
      },
      {
       "icon": "⚡",
       "color": "purple",
       "title": {
        "en": "FastAPI uses it",
        "ar": "FastAPI يستخدمه"
       },
       "text": {
        "en": "Your app will run at `http://127.0.0.1:8000`",
        "ar": "تطبيقك سيعمل على `http://127.0.0.1:8000`"
       }
      }
     ]
    },
    {
     "type": "compare",
     "left": {
      "title": {
       "en": "Works",
       "ar": "يعمل"
      },
      "tone": "good",
      "items": [
       {
        "en": "You open `localhost:8000` on your PC",
        "ar": "تفتح `localhost:8000` على جهازك"
       }
      ]
     },
     "right": {
      "title": {
       "en": "Does not work",
       "ar": "لا يعمل"
      },
      "tone": "bad",
      "items": [
       {
        "en": "A friend opens it on theirs",
        "ar": "صديقك يفتحه على جهازه"
       }
      ]
     }
    },
    {
