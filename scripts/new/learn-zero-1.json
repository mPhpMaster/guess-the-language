     "en": "The number `5`",
     "ar": "الرقم `5`"
    },
    {
     "en": "The calculator app",
     "ar": "تطبيق الآلة الحاسبة"
    },
    {
     "en": "The plus sign `+`",
     "ar": "علامة الجمع `+`"
