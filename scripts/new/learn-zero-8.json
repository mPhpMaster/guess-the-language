 "quiz": [
  {
   "id": 1,
   "difficulty": "easy",
   "question": {
    "en": "Which word starts a function definition in Python?",
    "ar": "ما الكلمة التي تبدأ بها تعريف دالة في بايثون؟"
   },
   "codeSnippet": "",
   "options": [
    {
     "en": "`function`",
     "ar": "`function`"
    },
    {
     "en": "`def`",
     "ar": "`def`"
    },
    {
     "en": "`func`",
     "ar": "`func`"
    },
    {
     "en": "`define`",
     "ar": "`define`"
    }
   ],
   "answer": 1,
   "explanation": {
    "en": "`def` (short for define) starts every function, like `def greet(name):`.",
    "ar": "`def` (اختصار define) تبدأ بها كل دالة، مثل `def greet(name):`."
   }
  },
  {
   "id": 2,
