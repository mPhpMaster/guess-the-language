    {
     "type": "code",
     "lang": "python",
     "code": "def greet(name, greeting=\"Hello\"):\n    return greeting + \", \" + name + \"!\"\n\nprint(greet(\"Sara\"))                 # Hello, Sara!\nprint(greet(\"Ali\", greeting=\"Hi\"))   # Hi, Ali!",
     "highlight": [
      4,
      5
     ]
    },
    {
     "type": "tip",
     "en": "`greeting=\"Hi\"` is a keyword argument: you name the input, so it is clear.",
     "ar": "`greeting=\"Hi\"` وسيط بالاسم (keyword argument): تُسمّي المُدخَل فيصبح واضحًا."
    },
    {
     "type": "code",
     "lang": "python",
     "code": "def add_print(a, b):\n    print(a + b)       # only shows it\n\ndef add_return(a, b):\n    return a + b       # hands it back\n\nx = add_print(2, 3)    # screen: 5\ny = add_return(2, 3)\nprint(x)               # None\nprint(y)               # 5",
     "highlight": [
      2,
      5,
      9,
      10
     ]
    },
    {
     "type": "compare",
     "left": {
      "title": {
       "en": "`return` hands it back",
       "ar": "`return` تُعيد القيمة"
      },
      "tone": "good",
      "items": [
       {
        "en": "The caller gets the value",
        "ar": "من استدعى الدالة يأخذ القيمة"
       },
       {
        "en": "`y = add_return(2, 3)` → `y` is `5`",
        "ar": "`y = add_return(2, 3)` ← `y` تساوي `5`"
       }
      ]
     },
     "right": {
      "title": {
       "en": "`print` only shows it",
       "ar": "`print` تعرض فقط"
      },
      "tone": "bad",
      "items": [
       {
        "en": "Text appears on the screen",
        "ar": "يظهر نص على الشاشة"
       },
       {
        "en": "`x = add_print(2, 3)` → `x` is `None`",
        "ar": "`x = add_print(2, 3)` ← `x` تساوي `None`"
       }
      ]
     }
    }
   ]
