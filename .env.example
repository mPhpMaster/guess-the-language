# Discord Activity (Embedded App SDK)
# Client ID is public — set in Vercel for production builds (VITE_ prefix).
VITE_DISCORD_CLIENT_ID=

# Server-only — add in Vercel dashboard, never commit.
DISCORD_CLIENT_SECRET=
# Optional dedicated HMAC secret for signed app sessions; falls back to DISCORD_CLIENT_SECRET.
APP_SESSION_SECRET=

# Supabase (optional — global leaderboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only key used by /api/report. Never expose this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
