# Discord Activity (Embedded App SDK)
# Client ID is public — set in Vercel for production builds (VITE_ prefix).
VITE_DISCORD_CLIENT_ID=

# Server-only — add in Vercel dashboard, never commit.
DISCORD_CLIENT_SECRET=

# Supabase (optional — global leaderboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
