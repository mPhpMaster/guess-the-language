# Copy to .env.local for local development, and set the same keys in the Vercel
# project settings for deployments. Mirrors the root project's .env.example so
# one set of credentials serves both builds.

# --- Discord Activity (Embedded App SDK) ---
# Client ID is public. Baked into the bundle at build time and also written to
# dist/discord-config.js by scripts/generate-runtime-config.mjs.
VITE_DISCORD_CLIENT_ID=

# Server-only — set in the Vercel dashboard, never commit.
DISCORD_CLIENT_SECRET=
# Optional dedicated HMAC secret for signed app sessions; falls back to
# DISCORD_CLIENT_SECRET. Changing it invalidates every issued session token.
APP_SESSION_SECRET=
# Extra admins, comma-separated Discord usernames (the owner is always included).
ADMIN_DISCORD_USERNAMES=

# --- Supabase (optional — leaderboard, rooms, profiles) ---
# Blank values degrade to offline solo play rather than breaking the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only key used by /api/report and /api/admin. Never expose with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Build target ---
# Electron loads over file://, which needs relative asset URLs. The desktop
# build script sets this for you; leave it blank for web and Discord builds.
GTL_BASE=
