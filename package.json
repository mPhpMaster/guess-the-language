{
    "name": "guess-the-language",
    "version": "2.3.0",
    "description": "IT quiz game for Windows.",
    "main": "src/main.js",
    "author": "mPhpMaster",
    "license": "MIT",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win",
        "pack": "electron-builder --dir"
    },
    "devDependencies": {
        "electron": "^39.8.5",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "com.mphpmaster.guessthelanguage",
        "productName": "Guess The Language",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                "nsis"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true
        }
    }
}