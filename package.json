{
  "name": "guess-the-language",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "IT quiz game for web, Windows and Discord. Svelte 5; the pre-rewrite app is archived in v1/.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-runtime-config.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "build:desktop": "node scripts/build-desktop.mjs",
    "electron": "electron .",
    "dist": "node scripts/build-desktop.mjs && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.2.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.0.0",
    "@supabase/supabase-js": "^2.112.2"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mphpmaster.guessthelanguage",
    "productName": "Guess The Language",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
